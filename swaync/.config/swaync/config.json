{
    "$schema": "/etc/xdg/swaync/configSchema.json",

    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "layer-shell": true,
    "cssPriority": "user",

    "// margins": "Waybar is 34px tall with a 6px top margin and an 8px side margin — clear it so toasts and the panel line up with the bar's right edge.",
    "control-center-margin-top": 46,
    "control-center-margin-bottom": 8,
    "control-center-margin-right": 8,
    "control-center-margin-left": 0,

    "notification-window-width": 380,
    "notification-icon-size": 48,
    "notification-body-image-height": 120,
    "notification-body-image-width": 200,
    "image-visibility": "when-available",

    "timeout": 8,
    "timeout-low": 5,
    "timeout-critical": 0,
    "transition-time": 200,

    "control-center-width": 400,
    "control-center-height": 600,
    "fit-to-screen": false,
    "keyboard-shortcuts": true,
    "hide-on-clear": true,
    "hide-on-action": true,
    "script-fail-notify": true,

    "widgets": [
        "title",
        "dnd",
        "mpris",
        "notifications"
    ],

    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "notifications": {
            "vexpand": true
        },
        "mpris": {
            "blacklist": [],
            "autohide": true,
            "show-album-art": "always",
            "loop-carousel": false
        }
    }
}
