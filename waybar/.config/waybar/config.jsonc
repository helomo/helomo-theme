// -*- mode: jsonc -*-
// Hyprland-native "floating islands" bar — matches the helomo theme
// (lavender #babbf1 accent, dark-purple translucent capsules, Hack Nerd Font).
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0, // island gaps come from per-module margins in style.css
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "backlight",
        "network",
        "battery",
        "hyprland/language",
        "idle_inhibitor",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": false,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a %d %b}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months":  "<span color='#babbf1'><b>{}</b></span>",
                "today":   "<span color='#f4b8e4'><b>{}</b></span>",
                "days":    "<span color='#c6d0f5'>{}</span>",
                "weekdays": "<span color='#8caaee'><b>{}</b></span>"
            }
        }
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-len": 30,
        "player-icons": {
            "default": "▶",
            "firefox": "󰈹",
            "spotify": "󰓇"
        },
        "status-icons": {
            "paused": "⏸"
        }
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "temperature": {
        // CPU (k10temp/Tctl). Pinned by device path so it survives hwmonN renumbering.
        // On a different machine, find yours with: cat /sys/class/hwmon/hwmon*/name
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°",
        "format-critical": "{icon} {temperatureC}°",
        "format-icons": ["", "", ""]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀 {ifname}",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "󰤭 offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "kitty -e nmtui"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo} ({power}W)"
    },

    "hyprland/language": {
        // Track the internal keyboard (always present); the us,ara toggle is global.
        // NOTE: format-<layout> overrides are avoided — they render as "…" on Waybar
        // 0.15.0. {short} yields the compact iso code (en/ar), uppercased via CSS-free
        // format below is not possible on GTK3, so we keep the lowercase code + glyph.
        "keyboard-name": "at-translated-set-2-keyboard",
        "format": "󰌌 {short}"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰛊"
        },
        "tooltip-format-activated": "Idle inhibited",
        "tooltip-format-deactivated": "Idle normal"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/powermenu.sh"
    }
}
