    "editor.tokenColorCustomizations": {
        "comments": {
            "foreground": "#7e8190",
            "fontStyle": "italic"
        },
        "strings": "#8fb3ac",
        "keywords": "#d6b8c8",
        "numbers": "#e0b088",
        "types": "#8fb8c4",
        "functions": "#8fa5c4",
        "variables": "#d6d2e0",
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#7e8190",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "string",
                    "string.quoted",
                    "constant.other.symbol"
                ],
                "settings": {
                    "foreground": "#8fb3ac"
                }
            },
            {
                "scope": [
                    "keyword",
                    "keyword.control",
                    "storage",
                    "storage.type"
                ],
                "settings": {
                    "foreground": "#d6b8c8"
                }
            },
            {
                "scope": [
                    "keyword.operator"
                ],
                "settings": {
                    "foreground": "#b9b3c4"
                }
            },
            {
                "scope": [
                    "constant.numeric",
                    "constant.language",
                    "constant.character"
                ],
                "settings": {
                    "foreground": "#e0b088"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function",
                    "meta.function-call"
                ],
                "settings": {
                    "foreground": "#8fa5c4"
                }
            },
            {
                "scope": [
                    "entity.name.type",
                    "entity.name.class",
                    "support.type",
                    "support.class"
                ],
                "settings": {
                    "foreground": "#8fb8c4",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "variable",
                    "variable.other",
                    "meta.definition.variable"
                ],
                "settings": {
                    "foreground": "#d6d2e0"
                }
            },
            {
                "scope": [
                    "variable.parameter"
                ],
                "settings": {
                    "foreground": "#a098a9",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "entity.name.tag",
                    "meta.tag"
                ],
                "settings": {
                    "foreground": "#e3b5cc"
                }
            },
            {
                "scope": [
                    "entity.other.attribute-name"
                ],
                "settings": {
                    "foreground": "#e0b088",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "invalid",
                    "invalid.illegal"
                ],
                "settings": {
                    "foreground": "#e08a94"
                }
            },
            {
                "scope": [
                    "markup.heading"
                ],
                "settings": {
                    "foreground": "#d6b8c8",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "markup.bold"
                ],
                "settings": {
                    "foreground": "#e0b088",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "markup.italic"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "markup.inline.raw",
                    "markup.fenced_code"
                ],
                "settings": {
                    "foreground": "#8fb3ac"
                }
            }
        ]
    },
    "editor.fontFamily": "'Hack Nerd Font', monospace",
    "terminal.integrated.fontFamily": "'Hack Nerd Font', monospace"
}
